{
  "name": "@qbits/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "generate": "openapi-typescript openapi.json -o src/schema.ts --properties-required-by-default",
    "verify": "npm run check:generated && tsc -p tsconfig.json && vitest run",
    "check:generated": "node scripts/check-schema.mjs"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@tanstack/react-query": "5.104.1",
    "@types/react": "^19.0.0",
    "msw": "2.15.0",
    "openapi-typescript": "7.13.0",
    "react": "19.3.0",
    "vitest": "5.0.3",
    "@testing-library/react": "16.3.3",
    "jsdom": "30.1.1",
    "react-dom": "19.3.0",
    "@types/react-dom": "^19.0.0"
  }
}
