          "idToken" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "KeyTerm" : {
        "properties" : {
          "meaning" : {
            "type" : "string"
          },
          "term" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "ResourceLink" : {
        "properties" : {
          "label" : {
            "type" : "string"
