# Copy this to deploy/aws/.env, fill it in, then run deploy-app.sh.
# This file is copied to /opt/qbits/.env on the instance and loaded by the qbits-backend
# systemd unit (EnvironmentFile=). Never commit the filled-in .env -- it's gitignored.

# -- Database (matches docker-compose.yml, which runs on the same instance) --
QBITS_DB_URL=jdbc:postgresql://localhost:5432/qbits
QBITS_DB_USER=qbits
QBITS_DB_PASSWORD=qbits

# -- Story writing --
QBITS_STORY_MODEL=
QBITS_STORY_MODE=digest

# -- Sources file: deploy-app.sh copies config/sources.yml to a flat /opt/qbits/app/config/,
# not the backend/../config layout `mvn spring-boot:run` uses locally, so this must be absolute.
QBITS_SOURCES_FILE=/opt/qbits/app/config/sources.yml

# -- Anthropic workload identity federation (leave ANTHROPIC_API_KEY unset here) --
# From Claude Console -> Settings -> Workload identity, after registering the AWS STS issuer
# that provision.sh printed.
ANTHROPIC_FEDERATION_RULE_ID=
ANTHROPIC_ORGANIZATION_ID=
ANTHROPIC_SERVICE_ACCOUNT_ID=
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_IDENTITY_TOKEN_FILE=/opt/qbits/identity-token

# -- Optional: raises GitHub's rate limit for open-source link checks --
GITHUB_TOKEN=

# -- Pages (spec 007): the canonical site origin for page links, and the web build's index.html,
# which the backend fills in for each page. deploy-app.sh adds QBITS_SHELL_FILE on the instance
# if it's missing here. --
QBITS_SITE_URL=https://qbitsnews.com
QBITS_SHELL_FILE=/opt/qbits/app/web/dist/index.html

# -- CORS: the public origin the web app will be served from. Update this to your domain (or
# http://<public-ip>) once you know it -- see deploy/aws/README.md "Hostname" section. --
QBITS_WEB_ORIGINS=http://localhost

# -- Optional accounts: any long random string signs session tokens. Generate one with
# `openssl rand -hex 32` (or leave blank -- login/register just answer AUTH_UNAVAILABLE). --
QBITS_AUTH_SECRET=

# -- Optional: Google sign-in. Same Client ID in both places (backend verifies the audience;
# the frontend needs it too, but as a build-time VITE_ variable -- deploy-app.sh reads
# VITE_GOOGLE_CLIENT_ID from this file and passes it to the web build automatically). --
QBITS_GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
